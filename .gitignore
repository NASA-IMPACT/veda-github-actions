# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Node / Vite (dashboards)
fte-dashboard/node_modules/
fte-dashboard/dist/
leave-dashboard/node_modules/
leave-dashboard/dist/

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp
*~

# Transient Playwright MCP artifacts (browser snapshots/screenshots)
.playwright-mcp/

# Env / secrets
.env
.env.local
*.pem

# Logs
*.log

# Reports + board tracking are *.csv / *.json — ignore those globally, then
# re-include the ones we DO track: the Action commits reports/, and the seed
# tracking files (sample_issues/created_issues/project_items) stay in the repo.
*.csv
*.json
!reports/*.csv
!seed/*.json

# Dashboard build config + bundled snapshot data (explicit re-includes past the
# global *.json/*.csv ignore; node_modules json is already excluded above).
!fte-dashboard/package.json
!fte-dashboard/package-lock.json
!fte-dashboard/tsconfig.json
!fte-dashboard/tsconfig.node.json
!fte-dashboard/public/data/*.csv
!pr-dashboard/index.snapshot.json

# Leave Tracker: action data (color map, fixtures, per-person override PRs) + dashboard
# config and bundled snapshot — re-included past the global *.json ignore.
!leave/colors.json
!leave/fixtures/*.json
!leave/overrides/*.json
!leave-dashboard/package.json
!leave-dashboard/package-lock.json
!leave-dashboard/tsconfig.json
!leave-dashboard/tsconfig.node.json
!leave-dashboard/public/data/*.json
