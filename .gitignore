# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Node / Vite (dashboards)
fte-dashboard/node_modules/
fte-dashboard/dist/
leave-dashboard/node_modules/
leave-dashboard/dist/

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp
*~

# Transient Playwright MCP artifacts (browser snapshots/screenshots)
.playwright-mcp/

# Env / secrets
.env
.env.local
*.pem

# Logs
*.log

# Reports + board tracking are *.csv / *.json — ignore those globally, then
# re-include the ones we DO track: the Action commits reports/, and the seed
# tracking files (sample_issues/created_issues/project_items) stay in the repo.
*.csv
*.json
!reports/*.csv
!seed/*.json

# Dashboard build config + bundled snapshot data (explicit re-includes past the
# global *.json/*.csv ignore; node_modules json is already excluded above).
!fte-dashboard/package.json
!fte-dashboard/package-lock.json
!fte-dashboard/tsconfig.json
!fte-dashboard/tsconfig.node.json
!fte-dashboard/public/data/*.csv
!pr-dashboard/index.snapshot.json

# Leave Tracker: action data (color map, fixtures, per-person override PRs) + dashboard
# config and bundled snapshot — re-included past the global *.json ignore.
!leave/colors.json
!leave/fixtures/*.json
!leave/overrides/*.json
!leave-dashboard/package.json
!leave-dashboard/package-lock.json
!leave-dashboard/tsconfig.json
!leave-dashboard/tsconfig.node.json
!leave-dashboard/public/data/*.json

# AWS Cost Calculator: generator fixtures + golden, dashboard config + bundled snapshot —
# re-included past the global *.json ignore.
!aws-pricing/seed/*.json
!cost-dashboard/package.json
!cost-dashboard/package-lock.json
!cost-dashboard/tsconfig.json
!cost-dashboard/tsconfig.node.json
!cost-dashboard/public/data/*.json

# Algorithm Catalog: dashboard config + the committed catalog data (algorithms/events/hazards)
# and the submitted request files — re-included past the global *.json ignore. Unlike dse-hub
# (which relies on `git add -f`), these negations mean a plain `git add algorithm-catalog/`
# picks the data up, so a future contributor can't silently drop it from a commit.
!algorithm-catalog/package.json
!algorithm-catalog/package-lock.json
!algorithm-catalog/tsconfig.json
!algorithm-catalog/tsconfig.node.json
!algorithm-catalog/data/*.json
!algorithm-catalog/data/requests/*.json

# Board Explorer: dashboard config, the bundled board snapshot the app falls back to, and the
# generator's offline fixture + golden — re-included past the global *.json ignore, the same way
# algorithm-catalog does it, so a plain `git add board-explorer/` picks everything up and nobody
# can silently ship the app without its data. (Verify with `git check-ignore --no-index -v <path>`;
# plain `git check-ignore` lies about already-tracked files.)
!board-explorer/package.json
!board-explorer/package-lock.json
!board-explorer/tsconfig.json
!board-explorer/tsconfig.node.json
!board-explorer/public/data/*.json
!board-explorer/scripts/fixtures/*.json
