---
import { TYPE_HUES, type EntryType } from "../content.config";

interface Props {
  type: EntryType;
}
const { type } = Astro.props;

// Hue comes from TYPE_HUES so the badge and the Type filter chip always match.
const h = TYPE_HUES[type] ?? 220;
const style = [
  `--tb-bg:hsl(${h} 55% 94%)`,
  `--tb-line:hsl(${h} 40% 78%)`,
  `--tb-ink:hsl(${h} 55% 30%)`,
  `--tb-dot:hsl(${h} 60% 45%)`,
].join(";");
---

<span class="type-badge" style={style}>{type}</span>
