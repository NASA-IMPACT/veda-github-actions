---
import type { CollectionEntry } from "astro:content";
import TypeBadge from "./TypeBadge.astro";
import TagChip from "./TagChip.astro";

interface Props {
  entry: CollectionEntry<"catalog">;
}
const { entry } = Astro.props;
const { title, description, type, tags, limitations, repo, homepage, featured, solves } =
  entry.data;
const href = `/catalog/${entry.id}/`;
const limCount = limitations.length;
---

<article
  class="card"
  data-entry
  data-slug={entry.id}
  data-type={type}
  data-tags={tags.join(" ")}
  data-title={title.toLowerCase()}
  data-text={`${title} ${description} ${tags.join(" ")}`.toLowerCase()}
>
  <div class="card__top">
    <TypeBadge type={type} />
    {featured && <span class="card__star" title="Featured">★</span>}
  </div>

  <h2 class="card__title">
    <a href={href}>{title}</a>
  </h2>
  <p class="card__desc">{description}</p>

  {
    solves && (
      <p class="card__solves">
        <span class="card__solves-label">◎ Solves</span>
        {solves}
      </p>
    )
  }

  {
    tags.length > 0 && (
      <div class="card__tags">
        {tags.slice(0, 5).map((t) => (
          <TagChip tag={t} />
        ))}
        {tags.length > 5 && <span class="tag-chip">+{tags.length - 5}</span>}
      </div>
    )
  }

  <div class="card__foot">
    <a class="card__lim" href={`${href}#limitations`} title="Documented limitations & risks">
      ⚠ {limCount} {limCount === 1 ? "limitation" : "limitations"}
    </a>
    <span class="card__links">
      {homepage && <a href={homepage} rel="noopener">live ↗</a>}
      <a href={repo} rel="noopener">source ↗</a>
      <a href={href}>details →</a>
    </span>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 18px 14px;
    box-shadow: var(--shadow);
    /* opacity + filter are here so the global hover-spotlight rule animates rather than snaps. */
    transition:
      transform 0.14s ease,
      border-color 0.14s ease,
      box-shadow 0.14s ease,
      opacity 0.16s ease,
      filter 0.16s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--ink-3);
    box-shadow: var(--shadow-lg, 0 2px 6px rgba(27, 26, 23, 0.1), 0 16px 36px rgba(27, 26, 23, 0.12));
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .card__star {
    color: var(--accent);
    font-size: 0.9rem;
  }
  .card__title {
    margin: 0;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
  }
  .card__title a {
    color: var(--ink);
  }
  .card__title a:hover {
    color: var(--accent-ink);
    text-decoration: none;
  }
  .card__desc {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .card__solves {
    margin: 0;
    padding: 10px 12px;
    background: color-mix(in srgb, var(--focus) 7%, var(--paper-2));
    border: 1px solid color-mix(in srgb, var(--focus) 24%, transparent);
    border-left: 3px solid var(--focus);
    border-radius: 8px;
    font-size: 0.88rem;
    color: var(--ink);
  }
  .card__solves-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--focus);
    margin-bottom: 3px;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px dashed var(--line-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .card__lim {
    color: var(--warn-ink);
    background: var(--warn-bg);
    border: 1px solid var(--warn-line);
    border-radius: 6px;
    padding: 2px 8px;
    white-space: nowrap;
  }
  .card__lim:hover {
    text-decoration: none;
    filter: brightness(0.97);
  }
  .card__links {
    display: inline-flex;
    gap: 12px;
  }
</style>
